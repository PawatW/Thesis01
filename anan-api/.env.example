# ============================================================
# ANAN API — ตัวอย่าง env  (copy เป็น .env แล้วเติมค่าจริง)
# .env ห้าม commit · ห้ามมีค่าพวกนี้อยู่ในโฟลเดอร์ anan/ (bundle ของ Expo เปิดอ่านได้)
# ============================================================

NODE_ENV=development
PORT=3000

# ---- Database (PostgreSQL 17 บนเครื่อง) ----
# ถ้ารหัสผ่านมีอักขระพิเศษ (@ : / ? # &) ต้อง URL-encode เช่น @ = %40
DATABASE_URL="postgresql://anan_app:ใส่รหัสผ่าน@localhost:5432/anan?schema=public"

# ---- JWT ----
# สร้างค่าใหม่ด้วย:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ใช้คนละค่ากันระหว่าง access กับ refresh — หลุดตัวหนึ่งต้องไม่ปลอมอีกตัวได้
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- CORS (origin ของแอป Expo) ----
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# SameSite ของ cookie ที่ถือ refresh token ของฝั่งเว็บ
# lax = พอสำหรับทุกกรณีที่หน้าจอกับ API อยู่ site เดียวกัน (รวม localhost คนละพอร์ต)
# none = เมื่อ deploy คนละโดเมนจริง ๆ เท่านั้น · ใช้ได้เฉพาะ NODE_ENV=production
#        เพราะมันบังคับ Secure = ต้องเป็น HTTPS (env.ts กันไว้ให้แล้ว)
REFRESH_COOKIE_SAMESITE=lax

# ---- โหมดเดโม่ ----
# true = admin สั่ง POST /admin/engine/run พร้อม runDate จำลองได้ (time-travel)
# ต้องเป็น false บนเครื่องจริงเสมอ — และถึงตั้ง true ก็ยังใช้ไม่ได้เมื่อ NODE_ENV=production
DEMO_MODE=true

# ---- Cloudinary (Phase 4 — ยังไม่ต้องใส่ตอนนี้) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- ที่อยู่ของแอปในสายตาผู้ใช้ (ใช้ประกอบลิงก์ในอีเมล) ----
# ต้องเป็น URL ของหน้าจอ (Expo web) ไม่ใช่ของ API
APP_WEB_URL=http://localhost:8081

# ---- SMTP (อีเมลขาออก — ตอนนี้ใช้กับลิงก์ "ลืมรหัสผ่าน" อย่างเดียว) ----
# ปล่อยว่างบนเครื่องพัฒนาได้: ระบบจะพิมพ์ลิงก์รีเซ็ตลง log ของ API แทนการส่งจริง
# แต่เมื่อ NODE_ENV=production แล้ว SMTP_HOST + MAIL_FROM ต้องมีค่า ไม่งั้น API ไม่บูต
# SMTP_SECURE=true คู่กับพอร์ต 465 · false คู่กับ 587 (STARTTLS)
# ★ ระบบตั้ง requireTLS ไว้เสมอ ★ เซิร์ฟเวอร์ที่ไม่รองรับ STARTTLS จะส่งไม่ผ่าน
# (ตั้งใจ — ในเมลมีลิงก์ที่ตั้งรหัสผ่านของบัญชีได้ ห้ามเดินทางแบบไม่เข้ารหัส)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ANAN <no-reply@anan.local>

# ---- โหมดเปลี่ยนเส้นทางอีเมล (DEV/UAT) ----
# true = ผู้ดูแลกดเปิดโหมดที่หน้า "ตั้งค่าเมล" ได้ (อีเมลทุกฉบับไปเข้ากล่องเดียว)
# ★ ต้องเป็น false บนเครื่องจริงเสมอ ★ เปิดบน production = ผู้ใช้จริงไม่ได้รับลิงก์
# กู้บัญชีอีกเลย และคนที่ถือปลายทางได้ลิงก์ของทุกคนแทน
# (ถึงตั้ง true ก็ยังใช้ไม่ได้เมื่อ NODE_ENV=production — กันไว้สองชั้น)
MAIL_UAT_MODE_AVAILABLE=false
