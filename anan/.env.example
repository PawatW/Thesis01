# ============================================================
# ANAN — Expo app env  (copy เป็น .env)
#
# ⚠️ ทุกตัวที่ขึ้นต้น EXPO_PUBLIC_ ถูก inline เข้า bundle = ผู้ใช้เปิดอ่านได้
#    → ห้ามใส่ความลับที่นี่เด็ดขาด (JWT secret / DB URL / Cloudinary secret
#      อยู่ใน anan-api/.env เท่านั้น — CLAUDE.md กฎข้อ 7)
# ============================================================

# ที่อยู่ของ API ของเรา
# - web / emulator บนเครื่องเดียวกัน : http://localhost:3000/api/v1
# - Expo Go บนมือถือจริง            : http://<IP ของเครื่องในวง LAN>:3000/api/v1
#   (ดู IP ด้วย ipconfig · API ต้อง bind 0.0.0.0)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
