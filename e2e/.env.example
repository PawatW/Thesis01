# ============================================================
# ANAN — Playwright e2e  (คัดลอกเป็น e2e/.env)
#
# ชุดนี้ **ล้างและ seed ฐานข้อมูลใหม่ทุกครั้งที่รัน**
# ชื่อ database ต้องลงท้ายด้วย _test มิฉะนั้น globalSetup จะปฏิเสธไม่ยอมรัน
# (ด่านกันอยู่ที่ e2e/setup/env.ts — fail-closed ไม่มีค่า default ให้เดา)
# ============================================================

# ฐานข้อมูลทดสอบ — คนละตัวกับ anan ที่ใช้พัฒนา
# role anan_app มีสิทธิ์ CREATEDB อยู่แล้ว globalSetup จะสร้าง DB ให้เองถ้ายังไม่มี
E2E_DATABASE_URL="postgresql://anan_app:abc123@localhost:5432/anan_test?schema=public"

# port ของ server ที่ globalSetup ยกขึ้นมาเอง — ตั้งคนละตัวกับ dev (3000 / 8081)
# จะได้เปิด dev server ค้างไว้แล้วรัน e2e คู่กันได้โดยไม่ชนกัน
E2E_API_PORT=3100
E2E_WEB_PORT=8082

# JWT secret: ถ้าไม่ใส่ที่นี่ จะยืมจาก anan-api/.env ให้อัตโนมัติ
# (ยืมได้เฉพาะ JWT_* — DATABASE_URL ไม่มีทางถูกยืมมาใช้)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# ข้ามขั้นตอน nest build ตอน globalSetup (ใช้เมื่อ dist ยังใหม่อยู่แล้ว รันซ้ำจะไวขึ้น)
# E2E_SKIP_API_BUILD=true
